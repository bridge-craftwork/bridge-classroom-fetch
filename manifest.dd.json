{
  "manifest_version": 3,
  "name": "Bridge Craftwork DD",
  "version": "0.1.0",
  "description": "Double-dummy review in Bridge Base Online's History panel: every card that cost a trick, and what should have been played instead.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Bridge Craftwork DD",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/ddBackground.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bridgebase.com/v3/*"],
      "js": ["src/ui/ddContent.js"],
      "run_at": "document_idle"
    },
    {
      "js": ["src/ui/ingestContent.js"],
      "matches": ["https://bridge-classroom.org/*", "https://bridge-classroom.com/*"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.bridgebase.com/v3/*"]
}
